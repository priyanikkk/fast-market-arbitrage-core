# Comma-separated venues (binance, bybit, okx, kucoin, gateio)
FMA_EXCHANGES=binance,bybit,okx,kucoin,gateio
FMA_QUOTE_ASSET=USDT
# Optional allow-list of base assets; leave empty to scan everything
FMA_SYMBOLS=

# Filters
FMA_MIN_SPREAD_PCT=0.3
FMA_MAX_SPREAD_PCT=15
FMA_MIN_QUOTE_VOLUME=50000
FMA_TAKER_FEE_PCT=0.1

# Network
FMA_REFRESH_INTERVAL=5
FMA_REQUEST_TIMEOUT=10
FMA_MAX_CONCURRENCY=10
FMA_MAX_RETRIES=3
# Comma-separated, rotated round-robin: http://user:pass@host:port
FMA_PROXIES=

# UI
FMA_TOP_N=20
